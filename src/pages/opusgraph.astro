---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';

const features = [
	{
		title: 'Catalog your whole library',
		summary:
			'Title, composer, arranger, publisher, instrumentation, copies owned, physical location, and condition—searchable and filterable by any combination.',
	},
	{
		title: 'Track parts, not just pieces',
		summary:
			'Structured part-by-part tracking with quantity and condition per part, so you know exactly what is on the shelf before you program it.',
	},
	{
		title: 'Performance history that sticks',
		summary:
			'Log concerts and services with full programs, and see at a glance when each piece was last performed as you plan the next season.',
	},
	{
		title: 'A reference database that fills in the blanks',
		summary:
			'Type a work title and OpusGraph suggests matches from its curated classical music database—auto-filling instrumentation, duration, and publisher.',
	},
	{
		title: 'Escape the spreadsheet',
		summary:
			'CSV import migrates your existing Google Sheets or Excel library with column mapping and duplicate detection.',
	},
	{
		title: 'Built for organizations',
		summary:
			'Each ensemble gets its own isolated library with owner, manager, and member roles—and individuals get the same features in a personal library.',
	},
];

const audiences = [
	{ title: 'Orchestras', body: 'Season planning, part tracking, and performance history for professional and community orchestras.' },
	{ title: 'Choirs and church music', body: 'Catalog octavos and service music, log services, and know your copy counts before rehearsal.' },
	{ title: 'Bands and ensembles', body: 'From wind bands to chamber groups—any ensemble that owns sheet music and programs concerts.' },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "OpusGraph",
	description:
		"A cloud-based platform for ensemble music library management—catalog sheet music, track parts, log performance history, and plan seasons, powered by a curated classical music reference database.",
	url: "https://elarenstudio.com/opusgraph/",
	operatingSystem: "Web",
	applicationCategory: "BusinessApplication",
	author: { "@type": "Organization", name: "Elaren Studio", url: "https://elarenstudio.com" },
	sameAs: ["https://opusgraph.vercel.app"],
};
---

<BaseLayout
	title="OpusGraph"
	description="OpusGraph is music library management for orchestras, choirs, and bands—catalog sheet music, track parts, log performance history, and plan seasons. An Elaren Studio product."
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<Header />
	<main>
		<!-- Hero -->
		<section class="container py-16 md:py-24">
			<div class="max-w-3xl">
				<p class="text-sm font-medium text-accent uppercase tracking-wider mb-3">An Elaren Studio product</p>
				<h1 class="text-4xl md:text-5xl font-semibold mb-6 text-ink">OpusGraph</h1>
				<p class="text-xl text-ink/80 leading-relaxed mb-6">
					Music library management for orchestras, choirs, bands, and other performing ensembles—replacing the spreadsheets most organizations rely on today.
				</p>
				<p class="text-ink/70 leading-relaxed mb-8">
					Catalog your sheet music, track parts and copies, log performance history, and plan seasons—powered by a curated classical music reference database that fills in the details for you.
				</p>
				<div class="flex flex-wrap gap-4">
					<a
						href="https://opusgraph.vercel.app"
						rel="noopener"
						class="inline-flex items-center justify-center px-8 py-4 bg-accent text-paper rounded-xl font-semibold no-underline shadow-xl shadow-accent/40 hover:shadow-2xl hover:shadow-accent/50 hover:-translate-y-0.5 transition-all duration-200"
					>
						Visit OpusGraph
					</a>
				</div>
			</div>
		</section>

		<!-- Features -->
		<section class="relative py-16 md:py-24 overflow-hidden" style="background-color: var(--clr-muted);">
			<div class="absolute top-0 right-0 w-96 h-96 bg-slate-300/25 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
			<div class="absolute bottom-0 left-0 w-80 h-80 bg-slate-300/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>
			<div class="container relative z-10">
				<SectionHeading
					kicker="What it does"
					title="Your music library, finally in order"
					description="Everything an ensemble librarian tracks—works, parts, copies, conditions, locations, and programs—in one place instead of seventeen tabs."
				/>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{features.map((feature) => (
						<div class="bg-paper rounded-xl p-8 border-2 border-slate-200 shadow-md hover:shadow-xl hover:shadow-slate-900/10 hover:border-accent/30 hover:-translate-y-1 transition-all duration-300">
							<h3 class="text-xl font-semibold mb-3 text-ink">{feature.title}</h3>
							<p class="text-ink/70 leading-relaxed mb-0">{feature.summary}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Who it's for -->
		<section class="bg-paper py-16 md:py-24">
			<div class="container">
				<SectionHeading
					kicker="Who it's for"
					title="Any ensemble with a library to keep"
					description="OpusGraph is multi-tenant: organizations get isolated libraries with roles, and individual musicians get a personal library with the same features."
				/>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{audiences.map((audience) => (
						<div class="bg-paper rounded-xl p-8 border-2 border-slate-200">
							<h3 class="text-lg font-semibold mb-3 text-ink">{audience.title}</h3>
							<p class="text-ink/70 leading-relaxed mb-0">{audience.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Status -->
		<section class="relative py-16 md:py-24" style="background-color: var(--clr-muted);">
			<div class="container">
				<div class="max-w-3xl mx-auto text-center">
					<p class="text-sm font-medium text-accent uppercase tracking-wider mb-3">Status</p>
					<h2 class="text-2xl md:text-3xl font-semibold mb-4 text-ink">Live</h2>
					<p class="text-lg text-ink/70 leading-relaxed mb-0">
						OpusGraph is live and in active development, with its reference database and library tools growing steadily. The studio maintains OpusGraph as one of its flagship products.
					</p>
				</div>
			</div>
		</section>

		<!-- Contact and legal -->
		<section class="container py-16 md:py-24">
			<div class="max-w-3xl mx-auto text-center">
				<h2 class="text-2xl md:text-3xl font-semibold mb-4 text-ink">Questions about OpusGraph?</h2>
				<p class="text-lg text-ink/70 mb-8 leading-relaxed">
					Email
					<a href="mailto:hello@elarenstudio.com" class="text-accent font-medium hover:underline">hello@elarenstudio.com</a>
					or use the studio contact page.
				</p>
				<a
					href="/contact"
					class="inline-flex items-center justify-center px-8 py-4 bg-accent text-paper rounded-xl font-semibold no-underline shadow-xl shadow-accent/40 hover:shadow-2xl hover:shadow-accent/50 hover:-translate-y-0.5 transition-all duration-200"
				>
					Contact Elaren Studio
				</a>
				<p class="text-sm text-ink/60 mt-10 mb-0 leading-relaxed">
					OpusGraph is built by Elaren Studio, a product studio operated by Wright Torres Group, LLC, which owns and operates OpusGraph.
				</p>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
