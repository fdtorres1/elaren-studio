---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const posts = [
	["01 / WHO IS IT FOR?", "Ages 10-14, curious about art, and ready to try something new? Northside Arts Workshop is planning six free Saturday sessions in Arlington. Beginners welcome. Register your interest when registration opens."],
	["02 / WHAT DOES IT COST?", "The workshop is free, and materials are included. The planned group has 24 places for Arlington students ages 10-14. Get the confirmed venue and registration details before signing up."],
	["03 / WHEN DOES IT MEET?", "Six Saturdays: October 17, 24, 31 and November 7, 14, 21. Sessions are planned for 10:00-11:30 a.m. Save the dates and look for confirmed registration information."],
	["04 / DO THEY NEED EXPERIENCE?", "First art workshop? That is welcome here. Students can explore materials and develop their own ideas with a teaching artist. No prior experience is required."],
	["05 / WHAT WOULD THEY DO?", "Make time to experiment. The planned workshop gives students six 90-minute sessions to explore visual art, use different materials, and work on their own creative ideas."],
	["06 / WHAT IS THE NEXT STEP?", "Interested in a place? Watch for confirmed venue, accessibility, and registration details. The planned workshop is free for 24 Arlington students ages 10-14."],
];
const articleSchema = { "@context": "https://schema.org", "@type": "Article", headline: "One brief. Several useful pieces.", description: "A fictional content marketing example showing one Northside Arts Workshop brief adapted into website, email, and six social posts.", datePublished: "2026-09-07", author: { "@type": "Organization", name: "Elaren Studio", url: "https://elarenstudio.com" }, publisher: { "@type": "Organization", name: "Elaren Studio", url: "https://elarenstudio.com" }, mainEntityOfPage: "https://elarenstudio.com/work-examples/program-campaign" };
---
<BaseLayout title="Program Campaign Example" description="A fictional content marketing example showing one Northside Arts Workshop brief adapted into website, email, and six social posts." ogType="article" articleDate="2026-09-07">
	<Header /><main>
		<section class="container py-16 md:py-24"><div class="max-w-3xl"><p class="mb-3 text-sm font-medium uppercase tracking-wider text-accent">Content marketing / work example</p><h1 class="mb-6 text-4xl font-semibold text-ink md:text-5xl">One brief. Several useful pieces.</h1><p class="mb-5 text-sm text-ink/60">By Elaren Studio · September 7, 2026</p><p class="rounded-xl border-2 border-accent/30 bg-accent/5 p-5 text-ink"><strong>Fictional demonstration:</strong> Northside Arts Workshop is invented for this example. It is not a real client, organization, registration, endorsement, award, or achieved result. Venue, accessibility, and registration must be confirmed before promotion.</p></div></section>
		<section class="container pb-16 md:pb-24"><div class="max-w-4xl"><h2 class="mb-4 text-3xl font-semibold text-ink">Website copy excerpt</h2><article class="rounded-xl border-2 border-slate-200 bg-paper p-7"><h3 class="text-2xl font-semibold text-ink">A place to make something of your own.</h3><p class="mt-4 text-ink/75">Six free Saturday arts sessions for Arlington students ages 10-14. Explore visual art with a teaching artist, try new materials, and develop your own ideas. No prior experience is needed.</p><p class="mt-4 text-ink/75"><strong>October 17-November 21, 2026</strong><br />Saturdays, 10:00-11:30 a.m.<br />24 places planned. Materials included.</p><p class="mt-4 font-semibold text-ink">Register your interest</p><p class="mt-2 text-sm text-ink/60">Demonstration CTA only. Venue, access details, and registration must be confirmed before a real campaign is published.</p></article>
		<h2 class="mt-14 mb-4 text-3xl font-semibold text-ink">Email / example copy</h2><article class="rounded-xl border-2 border-slate-200 bg-paper p-7"><p><strong>Subject:</strong> Six Saturdays to explore art</p><p class="mt-2 text-sm text-ink/65">A free workshop for Arlington students ages 10-14.</p><hr class="my-5 border-slate-200" /><p class="text-ink/75">Does your child enjoy making things? Northside Arts Workshop is planning six free Saturday sessions for 24 Arlington students ages 10-14.</p><p class="mt-3 text-ink/75">Students will explore visual art with a teaching artist. Materials are included, and beginners are welcome.</p><p class="mt-3 text-ink/75">Sessions are planned for October 17-November 21, from 10:00 to 11:30 a.m. Venue and accessibility details will be confirmed before registration opens.</p><p class="mt-3 font-semibold text-ink">Interested? Register your interest.</p><p class="mt-2 text-sm text-ink/60">Example copy only. No live registration is offered.</p></article>
		<h2 class="mt-14 mb-4 text-3xl font-semibold text-ink">Social / six distinct angles</h2><ol class="grid gap-4 md:grid-cols-2">{posts.map(([angle, post]) => <li class="rounded-xl border-2 border-slate-200 bg-paper p-5"><span class="text-sm font-semibold text-accent">{angle}</span><p class="mt-2 text-ink/75">{post}</p></li>)}</ol>
		<h2 class="mt-14 mb-4 text-3xl font-semibold text-ink">Publish-readiness checklist</h2><ul class="space-y-2 text-ink/75"><li>Confirm dates, venue, accessibility, registration link, photo permissions, and final approval.</li><li>Confirm every number against the approved source plan.</li><li>Replace the demonstration CTA with the verified action and contact route.</li><li>Schedule in the client’s existing systems; this sample does not publish anything.</li></ul>
		<p class="mt-12 text-sm text-ink/65">These six posts are sample angles from a demonstration, not a claim that a campaign ran or the complete twelve-post monthly deliverable. <a href="/content-marketing" class="text-accent hover:underline">See the content marketing scope</a> and <a href="/resources/guides/what-to-send-a-content-partner" class="text-accent hover:underline">what to send a content partner</a>.</p></div></section>
	</main><Footer /><script type="application/ld+json" set:html={JSON.stringify(articleSchema)} /></BaseLayout>
